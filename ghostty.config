font-family = MesloLGM Nerd Font Mono
font-size = 12
font-feature = -calt, -liga, -dlib
theme = Synthwave Everything
selection-invert-fg-bg = true
minimum-contrast = 2
keybind = shift+enter=text:\n

# Fix broken backspace/terminfo when ssh-ing to hosts lacking xterm-ghostty.
# Installs terminfo on the remote (cached per host); falls back to xterm-256color.
shell-integration-features = ssh-env,ssh-terminfo
